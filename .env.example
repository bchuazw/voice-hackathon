# Required — ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional — set this once you've cloned the user's voice for resurfacing
ELEVENLABS_USER_VOICE_ID=

# Required — Classifier LLM (one of these)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Required — Storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Required (for at least one integration)
TODOIST_API_TOKEN=

# Optional integrations
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Google Calendar (OAuth2 — fill in after one-time consent flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Cursor integration — path to a local repo where code thoughts get appended
# (e.g., C:\Users\bchua\Desktop\some-project)
CURSOR_TARGET_REPO_PATH=

# Public site URL (for callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# User timezone (IANA, e.g., Asia/Singapore, America/New_York)
USER_TIMEZONE=Asia/Singapore
